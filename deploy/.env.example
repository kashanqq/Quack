# LOCAL development only: example credentials, not real secrets.
# Copy to deploy/.env. From the repository root, use:
# docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
# Changing passwords here does not reset credentials in existing database volumes.
POSTGRES_DB=quack
POSTGRES_USER=quack
POSTGRES_PASSWORD=quack-local-postgres
NEO4J_PASSWORD=quack-local-neo4j

# Connection settings for the future application running on the host.
# Keep DATABASE_URL credentials in sync with POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://quack:quack-local-postgres@127.0.0.1:5432/quack
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
REDIS_URL=redis://127.0.0.1:6379/0
