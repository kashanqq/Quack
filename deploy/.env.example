# Example only; replace every credential before production use.
# For local development, copy to deploy/.env and run the base Compose file.
# In production use internal hostnames postgres, neo4j and redis in URLs.
# Changing passwords here does not reset existing database volumes.

# Application environment: local or prod.
ENV=local
# Public hostname for Caddy automatic HTTPS; replace on VPS.
DOMAIN=example.invalid

# PostgreSQL database name, user and password.
POSTGRES_DB=quack
POSTGRES_USER=quack
POSTGRES_PASSWORD=quack-local-postgres
# Neo4j password; user is configured separately below.
NEO4J_PASSWORD=quack-local-neo4j

# Async PostgreSQL URL; match POSTGRES_* and use @postgres on VPS.
DATABASE_URL=postgresql+asyncpg://quack:quack-local-postgres@127.0.0.1:5432/quack
# Neo4j Bolt URI; use bolt://neo4j:7687 on VPS.
NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j login name.
NEO4J_USER=neo4j
# Redis URL; use redis://redis:6379/0 on VPS.
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing secret: replace with a unique value of at least 32 bytes on VPS.
JWT_SECRET=change-me
# JWT cookie lifetime in days.
JWT_TTL_DAYS=30

# OpenAI-compatible LLM endpoint and private API key.
LLM_BASE_URL=
LLM_API_KEY=
# Chat and bulk model identifiers selected by B2.
MODEL_CHAT=
MODEL_BULK=
# Structured output mode: response_format or tool.
LLM_STRUCTURED_MODE=response_format
# LLM request timeouts in seconds.
LLM_TIMEOUT_CHAT_S=60
LLM_TIMEOUT_BULK_S=90
# Per-minute LLM request limits.
LLM_RPM_CHAT=10
LLM_RPM_BULK=10
# Set true only when deliberately simulating an outage.
LLM_FORCE_DOWN=false

# Optional Tavily key; empty value uses DDGS fallback.
TAVILY_API_KEY=
# Embedding model and expected vector dimension.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Structured logging level.
LOG_LEVEL=INFO
# Deployed commit version; workflow overrides this automatically.
GIT_SHA=dev
# Optional knowledge overrides use KNOWLEDGE__<PARAMETER>.
