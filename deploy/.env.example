# LOCAL development only: example credentials, not real secrets.
# Copy to deploy/.env. From the repository root, use:
# docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
# Changing passwords here does not reset credentials in existing database volumes.
POSTGRES_DB=quack
POSTGRES_USER=quack
POSTGRES_PASSWORD=quack-local-postgres
NEO4J_PASSWORD=quack-local-neo4j

# Connection settings for the future application running on the host.
# Keep DATABASE_URL credentials in sync with POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://quack:quack-local-postgres@127.0.0.1:5432/quack
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
REDIS_URL=redis://127.0.0.1:6379/0

# Language model block only (B2, backend/docs/decisions/llm-provider.md).
# The rest of Settings' variables (00-contracts.md §5) are filled in by B3
# on its own schedule — this is the one block B2 owns here.
LLM_BASE_URL=https://api.together.xyz/v1
LLM_API_KEY=
MODEL_CHAT=deepseek-ai/DeepSeek-V4-Flash-0731
MODEL_BULK=deepseek-ai/DeepSeek-V4-Pro-0813
LLM_STRUCTURED_MODE=response_format
LLM_STRICT_SCHEMA=0
LLM_REASONING_CHAT=low
LLM_REASONING_BULK=high
LLM_TIMEOUT_CHAT_S=60
LLM_TIMEOUT_BULK_S=90
LLM_RPM_CHAT=10
LLM_RPM_BULK=10
LLM_FORCE_DOWN=0
