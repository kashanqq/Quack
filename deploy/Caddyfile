{$DOMAIN} {
    encode gzip

    # API under /api (frontend is built with NEXT_PUBLIC_API_URL=/api): one origin,
    # so the session cookie works without CORS. flush_interval -1 keeps SSE chat streaming.
    handle_path /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

    # Release smoke (scripts/check_release.py) checks https://DOMAIN/health
    handle /health {
        reverse_proxy api:8000
    }

    # Static Next.js export baked into the image (deploy/Dockerfile.web)
    handle {
        root * /srv/web
        try_files {path} {path}.html {path}/index.html /index.html
        file_server
    }
}
